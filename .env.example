PORT=4000
# --- Local PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sathsangath
DB_USER=postgres
DB_PASSWORD=your-password
# Prisma reads this one (built from the DB_* values above)
DATABASE_URL="postgresql://postgres:your-password@localhost:5432/sathsangath?schema=public"
# Supabase: DATABASE_URL = pooler (Transaction mode, port 6543):
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL = direct connection (port 5432), used by `prisma db push` / migrations. Locally it can equal DATABASE_URL.
DIRECT_URL="postgresql://postgres:your-password@localhost:5432/sathsangath?schema=public"
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Comma-separated list of allowed web origins (mobile apps do not need CORS)
# https://sathsangath-frontend.vercel.app is always allowed in code
CORS_ORIGINS="http://localhost:3100,http://127.0.0.1:3100"
# Shared secret for the Google Form / Apps Script webhook
INTAKE_WEBHOOK_SECRET="change-me-webhook-secret"
# Website login link sent inside credential SMS/emails
WEB_LOGIN_URL="http://localhost:3100/login"
# Seed admin (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@sathsangath.in"
SEED_ADMIN_PASSWORD="Admin@12345"

# --- Media storage (Cloudflare R2; provider + bucket are set in src/lib/config.ts) ---
CLOUDFLARE_S3_API_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_SECRET_KEY=""

# --- Email (Gmail SMTP with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM_NAME=Sathsangath

# --- SMS (Twilio). Leave empty for console mode. ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

SUPPORT_EMAIL=sathsangath888@gmail.com
SUPPORT_PHONE=+91 70160 40925
SUPPORT_WHATSAPP=https://wa.me/917016040925


# Firebase project used to verify Google sign-in tokens
FIREBASE_PROJECT_ID=sathsangath-9014

# PostHog logs. Leave POSTHOG_API_KEY empty to keep logs on the host only (Vercel / terminal).
# Use the project token (phc_…), not a personal API key. EU cloud: POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
