generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN") // SUPER_ADMIN | ADMIN | STAFF
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  audits       AuditLog[]
}

// A Firebase-backed sign-in (email+password or Google). The Member row is created when bio data is submitted.
model Account {
  id          String    @id @default(cuid())
  firebaseUid String    @unique
  email       String    @unique
  createdAt   DateTime  @default(now())
  lastLoginAt DateTime?
  member      Member?
}

// One row per bio data. Once approved the same row is the login account.
model Member {
  id                 String   @id @default(cuid())
  profileCode        String   @unique // shown instead of the real name, e.g. SS-1042
  status             String   @default("PENDING") // PENDING | CORRECTION | REJECTED | APPROVED | SUSPENDED
  adminNote          String?
  source             String   @default("WEB") // WEB | GOOGLE_FORM | ADMIN

  // --- identity (MASKED for other members) ---
  fullName           String
  phone              String   @unique
  email              String?
  familyPhone        String?
  familyEmail        String?

  // --- visible bio data ---
  gender             String   // MALE | FEMALE
  dob                DateTime
  dobIsApproximate   Boolean  @default(false) // true when only age was given (admin entry); dob is synthesised as Jul 1 of that year
  birthTime          String?  // "HH:MM", 24-hour. Horoscope data: admin only, never sent to another member.
  birthPlace         String?  // city of birth. Horoscope data: admin only, never sent to another member.
  heightCm           Int?
  weightKg           Int?
  maritalStatus      String?
  community          String?
  subCommunity       String?
  city               String?
  nativePlace        String?
  country            String   @default("IN") // ISO code of the country they live in
  religion           String   @default("Hindu")
  state              String?
  education          String?
  profession         String?
  income             String?
  diet               String?
  fatherOccupation   String?
  motherOccupation   String?
  siblings           String?
  familyBackground   String?
  about              String?
  motherTongue       String?
  fatherName         String?  // admin-only
  motherName         String?  // admin-only
  familyType         String?  // Joint | Nuclear | ...
  createdBy          String?  // Self | Parent | Sibling | Relative (admin-only)
  photoUrl           String?
  biodataFileUrl     String?  // admin-only original document
  idProofType        String?  // AADHAAR | GREEN_CARD | VISA | PASSPORT | OTHER (private, admin only)
  idProofUrl         String?  // storage key of the ID proof (private, admin only)

  // --- partner preferences (comma separated lists) ---
  prefCommunities    String   @default("")
  prefCities         String   @default("")
  prefEducation      String   @default("")
  prefOccupation     String   @default("")
  prefAgeMin         Int?
  prefAgeMax         Int?
  prefIncomeMin      String?
  prefCountries      String   @default("")
  prefNotes          String?
  prefHeightMinCm    Int?
  prefMaritalStatus  String?
  prefRelocate       String?  // Yes | Maybe | No
  consentGiven       Boolean  @default(false)

  // --- login ---
  accountId          String?  @unique
  account            Account? @relation(fields: [accountId], references: [id])
  passwordHash       String?
  mustChangePassword Boolean  @default(true)
  lastLoginAt        DateTime?
  fcmToken           String?  // Firebase Cloud Messaging device token for push notifications

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  approvedAt         DateTime?

  tags               MemberTag[]
  photos             Photo[]
  suggestionsReceived Suggestion[] @relation("SuggestionViewer")
  suggestedTo         Suggestion[] @relation("SuggestionProfile")
  likesGiven         Like[]          @relation("Liker")
  likesReceived      Like[]          @relation("Liked")
  introRequests      IntroRequest[]  @relation("Requester")
  introTargets       IntroRequest[]  @relation("Target")
  overridesAsViewer  VisibilityOverride[] @relation("OverrideViewer")
  overridesAsProfile VisibilityOverride[] @relation("OverrideProfile")
  membershipPlans    MembershipPlan[]
}

model MembershipPlan {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan      String   // BASIC | PRO
  startDate DateTime
  endDate   DateTime
  note      String?
  createdBy String?  // admin name/email who assigned it
  createdAt DateTime @default(now())
  @@index([memberId])
}

// Admin-configurable tag system: category (Community, City, Education...) -> values.
model TagCategory {
  id     String     @id @default(cuid())
  name   String     @unique
  values TagValue[]
}

model TagValue {
  id         String      @id @default(cuid())
  categoryId String
  value      String
  category   TagCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  members    MemberTag[]
  @@unique([categoryId, value])
}

model MemberTag {
  memberId   String
  tagValueId String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tagValue   TagValue @relation(fields: [tagValueId], references: [id], onDelete: Cascade)
  @@id([memberId, tagValueId])
}

// Admin manual show/hide of one profile for one viewer.
model VisibilityOverride {
  id        String @id @default(cuid())
  viewerId  String
  profileId String
  action    String // SHOW | HIDE
  viewer    Member @relation("OverrideViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  profile   Member @relation("OverrideProfile", fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([viewerId, profileId])
}

model Like {
  id        String   @id @default(cuid())
  likerId   String
  likedId   String
  createdAt DateTime @default(now())
  liker     Member   @relation("Liker", fields: [likerId], references: [id], onDelete: Cascade)
  liked     Member   @relation("Liked", fields: [likedId], references: [id], onDelete: Cascade)
  @@unique([likerId, likedId])
}

model IntroRequest {
  id          String   @id @default(cuid())
  requesterId String
  targetId    String
  status      String   @default("NEW") // NEW | UNDER_REVIEW | INTRODUCTION_FACILITATED | CLOSED
  message     String?
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  requester   Member   @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  target      Member   @relation("Target", fields: [targetId], references: [id], onDelete: Cascade)
  @@unique([requesterId, targetId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteContent {
  key       String   @id // e.g. home.hero, about.story
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String    @id @default(cuid())
  adminId   String?
  actorType String    @default("ADMIN") // ADMIN | MEMBER | PUBLIC
  actorName String?
  memberId  String?
  action    String
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime  @default(now())
  admin     AdminUser? @relation(fields: [adminId], references: [id])
}

model Photo {
  id        String   @id @default(cuid())
  memberId  String
  url       String
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  @@index([memberId])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// In-app notifications. audience ADMIN = staff bell, MEMBER = one member (memberId).
model Notification {
  id        String   @id @default(cuid())
  audience  String   // ADMIN | MEMBER
  memberId  String?
  type      String   // MUTUAL_LIKE | ANNOUNCEMENT
  title     String
  body      String
  data      String?  // JSON (e.g. the two member ids) for deep links
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([audience, memberId, read])
}

// "Suggested by Sathsangath": the admin team hand-picks a bride / groom for a member.
// The suggested profile always appears for that member (like an admin SHOW rule) and carries a badge.
model Suggestion {
  id        String   @id @default(cuid())
  viewerId  String   // member who receives the suggestion
  profileId String   // the suggested bride / groom
  note      String?
  adminId   String?
  createdAt DateTime @default(now())
  viewer    Member   @relation("SuggestionViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  profile   Member   @relation("SuggestionProfile", fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([viewerId, profileId])
  @@index([viewerId])
}
