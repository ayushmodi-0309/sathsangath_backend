{
  "name": "sathsangath-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Sathsangath REST API (admin + member modules). Mobile-app ready: stateless JWT, versioned /api/v1.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "postinstall": "prisma generate",
    "start": "node dist/server.js",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "tsx prisma/seed-test-members.ts",
    "db:seed:more": "tsx prisma/seed-more-members.ts",
    "db:seed:50": "tsx prisma/seed-50-users.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "mail:check": "tsx scripts/mail-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "firebase-admin": "^13.0.0",
    "cors": "^2.8.6",
    "country-state-city": "^3.2.1",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "5.10.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "protobufjs@7.6.6": true,
    "@firebase/util@1.15.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
